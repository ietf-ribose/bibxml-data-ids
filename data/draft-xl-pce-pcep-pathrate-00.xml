    <title>PCEP Extension for Path Rate</title>
    <seriesInfo name="Internet-Draft" value="draft-xl-pce-pcep-pathrate-00"/>
    <author initials="Q." surname="Xiong" fullname="Quan Xiong">
      <organization>ZTE Corporation</organization>
